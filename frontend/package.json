{
  "name": "tiki-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run check && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "cd .. && oxlint --deny-warnings --report-unused-disable-directives-severity error frontend scripts",
    "format": "cd .. && oxfmt --write frontend scripts .oxfmtrc.json .oxlintrc.jsonc",
    "format:check": "cd .. && oxfmt --check frontend scripts .oxfmtrc.json .oxlintrc.jsonc",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.48.0",
    "@playwright/test": "^1.58.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.0.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
